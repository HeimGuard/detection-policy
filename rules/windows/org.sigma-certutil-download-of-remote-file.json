{
  "key": "org.sigma-certutil-download-of-remote-file",
  "name": "Certutil Download Of Remote File",
  "description": "Detects certutil used to download a file from a URL. Converted from Sigma rule 19b08b1c-861d-4e75-a1ef-ea0c1baf202b.",
  "severity": "high",
  "platform": "windows",
  "source": "processes",
  "when": {
    "all": [
      {
        "field": "Path",
        "op": "ends_with",
        "value": "\\certutil.exe"
      },
      {
        "field": "CommandLine",
        "op": "contains",
        "value": "urlcache"
      },
      {
        "field": "CommandLine",
        "op": "contains",
        "value": "http"
      },
      {
        "not": {
          "field": "CommandLine",
          "op": "contains",
          "value": "internal.example"
        }
      }
    ]
  },
  "message": "{Name} {CommandLine}",
  "remediation": "False positives: Administrators fetching certificates"
}
