{
  "key": "org.msrc-windows-10-0-17763-9245",
  "name": "Windows 10 Version 1809, Windows Server 2019 (build 10.0.17763): the update 10.0.17763.9245 is missing (7 CVEs)",
  "description": "Microsoft's security update 10.0.17763.9245 of Windows 10 Version 1809, Windows Server 2019 (build 10.0.17763) fixes 7 CVEs (2026-Oct). CVEs: CVE-2026-69789, CVE-2026-69354, CVE-2026-69363, CVE-2026-69521, CVE-2026-70067, CVE-2026-87706, CVE-2026-87707",
  "severity": "critical",
  "platform": "windows",
  "source": "os",
  "when": {
    "all": [
      {
        "field": "Id",
        "op": "eq",
        "value": "windows"
      },
      {
        "field": "Version",
        "op": "starts_with",
        "value": "10.0.17763."
      },
      {
        "field": "Version",
        "op": "version_lt",
        "value": "10.0.17763.9245"
      }
    ]
  },
  "message": "{Name} {Version} is older than 10.0.17763.9245, the update that fixes 7 CVEs: CVE-2026-69789, CVE-2026-69354, CVE-2026-69363, CVE-2026-69521, CVE-2026-70067, CVE-2026-87706, CVE-2026-87707",
  "remediation": "Install the latest cumulative update (Windows Update).",
  "urls": [
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-69789",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-69354",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-69363",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-69521",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-70067",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-87706",
    "https://msrc.microsoft.com/update-guide"
  ]
}
