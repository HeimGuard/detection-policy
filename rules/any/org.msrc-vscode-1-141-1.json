{
  "key": "org.msrc-vscode-1-141-1",
  "name": "Visual Studio Code: the update 1.141.1 is missing (10 CVEs)",
  "description": "Microsoft's security update 1.141.1 of Visual Studio Code fixes 10 CVEs (2026-Oct). CVEs: CVE-2026-102229, CVE-2026-102231, CVE-2026-102232, CVE-2026-102233, CVE-2026-102234, CVE-2026-102235, CVE-2026-102238, CVE-2026-102851, CVE-2026-69370, CVE-2026-70098",
  "severity": "high",
  "platform": "any",
  "source": "software",
  "when": {
    "all": [
      {
        "any": [
          {
            "field": "Name",
            "op": "matches",
            "value": "^microsoft visual studio code( \\(user\\))?$"
          },
          {
            "all": [
              {
                "field": "Name",
                "op": "eq",
                "value": "code"
              },
              {
                "field": "Source",
                "op": "in",
                "value": [
                  "dpkg",
                  "snap"
                ]
              }
            ]
          },
          {
            "field": "Name",
            "op": "eq",
            "value": "com.visualstudio.code"
          }
        ]
      },
      {
        "field": "Version",
        "op": "version_lt",
        "value": "1.141.1"
      }
    ]
  },
  "message": "{Name} {Version} is older than 1.141.1, the update that fixes 10 CVEs: CVE-2026-102229, CVE-2026-102231, CVE-2026-102232, CVE-2026-102233, CVE-2026-102234, CVE-2026-102235, CVE-2026-102238, CVE-2026-102851, CVE-2026-69370, CVE-2026-70098",
  "remediation": "Update Visual Studio Code.",
  "urls": [
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-102229",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-102231",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-102232",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-102233",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-102234",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-102235",
    "https://msrc.microsoft.com/update-guide"
  ]
}
