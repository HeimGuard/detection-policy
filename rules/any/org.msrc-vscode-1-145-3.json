{
  "key": "org.msrc-vscode-1-145-3",
  "name": "Visual Studio Code: the update 1.145.3 is missing (19 CVEs)",
  "description": "Microsoft's security update 1.145.3 of Visual Studio Code fixes 19 CVEs (2026-Nov). CVEs: CVE-2026-102230, CVE-2026-102236, CVE-2026-114171, CVE-2026-119975, CVE-2026-119976, CVE-2026-119981, CVE-2026-119982, CVE-2026-119983, CVE-2026-119985, CVE-2026-120779, CVE-2026-120780, CVE-2026-120782, CVE-2026-121660, CVE-2026-121661, CVE-2026-121662, CVE-2026-121663, CVE-2026-121664, CVE-2026-121665, CVE-2026-70094",
  "severity": "high",
  "platform": "any",
  "source": "software",
  "when": {
    "all": [
      {
        "any": [
          {
            "field": "Name",
            "op": "matches",
            "value": "^microsoft visual studio code( \\(user\\))?$"
          },
          {
            "all": [
              {
                "field": "Name",
                "op": "eq",
                "value": "code"
              },
              {
                "field": "Source",
                "op": "in",
                "value": [
                  "dpkg",
                  "snap"
                ]
              }
            ]
          },
          {
            "field": "Name",
            "op": "eq",
            "value": "com.visualstudio.code"
          }
        ]
      },
      {
        "field": "Version",
        "op": "version_lt",
        "value": "1.145.3"
      }
    ]
  },
  "message": "{Name} {Version} is older than 1.145.3, the update that fixes 19 CVEs: CVE-2026-102230, CVE-2026-102236, CVE-2026-114171, CVE-2026-119975, CVE-2026-119976, CVE-2026-119981, CVE-2026-119982, CVE-2026-119983, CVE-2026-119985, CVE-2026-120779, CVE-2026-120780, CVE-2026-120782, CVE-2026-121660, CVE-2026-121661, CVE-2026-121662, CVE-2026-121663, CVE-2026-121664, CVE-2026-121665, CVE-2026-70094",
  "remediation": "Update Visual Studio Code.",
  "urls": [
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-102230",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-102236",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-114171",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119975",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119976",
    "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119981",
    "https://msrc.microsoft.com/update-guide"
  ]
}
