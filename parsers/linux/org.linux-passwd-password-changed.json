{
  "key": "org.linux-passwd-password-changed",
  "name": "passwd: password changed",
  "description": "The PAM line that follows a changed password (the person's own or one set by root).",
  "source": "linux.auth",
  "when": {
    "field": "Identifier",
    "op": "eq",
    "value": "passwd"
  },
  "pattern": "password changed for (?<user>\\S+)",
  "event": {
    "type": "password_changed",
    "user": "{user}",
    "source": "passwd",
    "message": "Password changed for {user}"
  }
}
