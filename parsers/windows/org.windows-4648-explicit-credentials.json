{
  "key": "org.windows-4648-explicit-credentials",
  "name": "Windows: logon with explicit credentials",
  "source": "windows.security",
  "when": {"field": "Id", "op": "eq", "value": 4648},
  "event": {"type": "explicit_credentials", "user": "{Data.TargetUserName}", "source": "{Data.IpAddress|Data.WorkstationName}", "message": "explicit credentials used for {Data.TargetUserName}"}
}
