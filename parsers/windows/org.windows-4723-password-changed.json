{
  "key": "org.windows-4723-password-changed",
  "name": "Windows: password changed by the account",
  "description": "4723: an account changed its own password.",
  "source": "windows.security",
  "when": {
    "field": "Id",
    "op": "eq",
    "value": 4723
  },
  "event": {
    "type": "password_changed",
    "user": "{Data.TargetUserName}",
    "source": "{Data.SubjectUserName}",
    "message": "{Data.SubjectUserName} changed the password of {Data.TargetUserName}"
  }
}
